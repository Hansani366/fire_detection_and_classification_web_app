# ── VLM ───────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Human detection (optional) ────
# Person confidence floor for the occupancy count. Higher than the fire
# detector's 0.35 on purpose: every box that survives is +1 on an evacuation
# head-count, whereas a false smoke box only asks the VLM for a second opinion.
# Raise it if the count reads high in a busy scene; lower it if people at the
# back of a room are being missed.
HUMAN_MIN_CONF=0.40

# ── ESP32-CAM (optional) ──────────
# Base URL of the board — it prints ">>> OPEN THIS: http://<ip>" on the
# 115200 serial monitor at boot. The dashboard can override this at runtime,
# so a new DHCP lease does not need a rebuild.

# Get the IP address from router settings
# http://192.168.1.1/index.html?t=#device_settings
ESP32_CAM_URL=http://192.168.1.197

# ── ESP32 sensor nodes (optional) ──
# Shared secret the nodes send as the X-Device-Key header. esp32-sensor-service
# publishes 8022 in the clear on the LAN so the boards can POST without
# fighting nginx's self-signed cert, so set this if the network is not yours
# alone. Empty (the default) accepts any device that can reach the port.
# Must match DEVICE_KEY in the sketch's config.h.
SENSOR_INGEST_KEY=

# Note: the nodes need THIS machine's LAN address, not one configured here —
# it goes in the sketch as SERVER_URL, e.g.
#   http://192.168.1.118:8022/api/sensors/ingest
