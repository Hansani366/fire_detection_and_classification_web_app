# ─────────────────────────────────────────────────────────────────────────────
# FireWatch configuration
#
# Copy this file to .env and edit it. Every setting the stack exposes is here,
# and each one keeps its default in docker-compose.yml, so a missing or partial
# .env still starts the system with the values documented below.
#
# Environment variables are read when a CONTAINER STARTS. After a change, run
#   docker compose up -d --force-recreate <service>
# A plain `docker compose restart` keeps the old value.
#
# .env is gitignored and is never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Vision language model ─────────────────────────────────────────────────────
# Required. The verification stage, the situation report and the gas warning
# text all call Gemini, and the service refuses to start without a key.
GOOGLE_API_KEY=your_google_api_key_here

# ── Facility ──────────────────────────────────────────────────────────────────
# Which facility to load from alert-service/sites/. `unit7` is the demonstration
# hall; `home` is the trial facility. This picks the zone catalogue AND the
# evacuation graph together, so the two can never describe different buildings.
SITE_KEY=home

# Display name only. Leave blank to use the name inside the site file.
SITE_NAME=Home

# How close to the fire a walkable segment may pass before it is blocked.
# Blank uses the radius in the site file: 6 m for unit7, 2 m for home. A radius
# sized for a 36 m hall reaches every room of a 13 m house, which is why it is
# a property of the site rather than one number for both.
HAZARD_RADIUS_M=

# ── Incidents ─────────────────────────────────────────────────────────────────
# Minimum seconds between two separate incidents in one zone. Stops a single
# fire being reported many times while it flickers in and out of view.
COOLDOWN_SECONDS=120

# No fire event for this long and the incident closes and the zone returns to
# clear.
CLEAR_AFTER_SECONDS=30

# ── Sensor grading thresholds ─────────────────────────────────────────────────
# The values the sensor service grades each reading against. Warn and danger in
# ppm for the gas channels and degrees Celsius for temperature.
#
# Combustible gas and smoke (MQ-2). Reacts before a flame is visible, but also
# reacts to cooking, sprays, solvents and exhaust.
SENSOR_MQ2_WARN=400
SENSOR_MQ2_DANGER=800

# Carbon monoxide (MQ-7). 35 ppm is the eight hour exposure ceiling and 100 ppm
# is clearly dangerous, so these follow occupational limits rather than values
# specific to fire.
SENSOR_MQ7_WARN=35
SENSOR_MQ7_DANGER=100

# Temperature (DHT22). Reliable but slow, because the fire must already be large.
SENSOR_TEMP_WARN=45
SENSOR_TEMP_DANGER=60

# ── Sensor nodes ──────────────────────────────────────────────────────────────
# No sample for this long and the node is reported stale rather than normal. A
# node that has stopped sending must never read as a quiet room.
SENSOR_STALE_AFTER_S=15

# Samples kept per node, about 36 minutes at one message every 3 seconds.
SENSOR_HISTORY_MAX=720

# Shared secret the nodes send as the X-Device-Key header. esp32-sensor-service
# publishes 8022 in the clear on the LAN so the boards can POST without fighting
# nginx's self-signed certificate, so set this if the network is not yours
# alone. Blank accepts any device that can reach the port. Must match DEVICE_KEY
# in the sketch's config.h.
SENSOR_INGEST_KEY=

# Note: the nodes need THIS machine's LAN address, which is not configured here.
# It goes in the sketch as SERVER_URL, for example
#   http://192.168.1.118:8022/api/sensors/ingest

# ── Human detection ───────────────────────────────────────────────────────────
# Person confidence floor for the occupancy count. Higher than the fire
# detector's 0.35 on purpose: every box that survives adds one to an evacuation
# head count, whereas a false smoke box only asks the VLM for a second opinion.
# Raise it if the count reads high in a busy scene; lower it if people at the
# back of a room are missed.
HUMAN_MIN_CONF=0.40

# ── ESP32-CAM ─────────────────────────────────────────────────────────────────
# Base URL of the board. It prints ">>> OPEN THIS: http://<ip>" on the 115200
# serial monitor at boot. The dashboard can override this at runtime, so a new
# DHCP lease does not need a rebuild. Blank is fine if you use a webcam.
ESP32_CAM_URL=
