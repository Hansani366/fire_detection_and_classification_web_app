# ── VLM ───────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── ESP32-CAM (optional) ──────────
# Base URL of the board — it prints ">>> OPEN THIS: http://<ip>" on the
# 115200 serial monitor at boot. The dashboard can override this at runtime,
# so a new DHCP lease does not need a rebuild.

# Get the IP address from router settings
# http://192.168.1.1/index.html?t=#device_settings
ESP32_CAM_URL=http://192.168.1.197
