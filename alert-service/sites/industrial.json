      "why": "The east fire exit is 5.1 m from the fire and is cut. The south door at 19.6 m is then the nearest of the three that remain."
    },
    "warehouse": {
      "exitId": "exit-north",
      "lengthM": 19.97,
      "refugeExpected": false,
      "why": "The east fire exit is cut by the fire. The north door at 20.0 m beats the south door at 29.4 m."
    },
    "boiler": {
      "exitId": "exit-bay",
      "lengthM": 13.39,
      "refugeExpected": false,
      "why": "The south door is 5.9 m from the fire and is cut; the loading bay is the next nearest."
    },
