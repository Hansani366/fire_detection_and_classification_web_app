  "groundTruth": {
    "kitchen": {
      "exitId": "exit-north",
      "lengthM": 5.0,
      "refugeExpected": false,
      "why": "The kitchen's own fire does not block its door (2.36 m away, radius 2.0), so the occupant leaves through the dining area to the front door."
    },
    "dining": {
      "exitId": "exit-south",
      "lengthM": 9.8,
      "refugeExpected": false,
      "why": "Scenario 2. The fire sits beside the front door, which is the nearest exit by straight line and the wrong one. The correct route reverses and runs south through the living area."
    },
    "living": {
      "exitId": "exit-south",
      "lengthM": 4.78,
      "refugeExpected": false,
      "why": "The fire sits in the middle of the house. Both doors stay open, and the back door is the nearer of the two along the graph."
    },
    "verander": {
      "exitId": "exit-north",
      "lengthM": 9.7,
      "refugeExpected": false,
      "why": "Scenario 3. The back door itself is clear, but the fire sits across the only path to it, so the route runs the length of the house to the front door instead."
    },
    "bedroom-west": {
      "exitId": "exit-south",
      "lengthM": 10.06,
      "refugeExpected": false,
      "why": "Nothing is cut, and the back door is nearer than the front along the hallway."
    },
    "bedroom-southwest": {
      "exitId": "exit-south",
      "lengthM": 6.22,
      "refugeExpected": false,
      "why": "Nothing is cut. The shortest walk is south to the back door."
    },
    "bedroom-northeast": {
      "exitId": "exit-north",
      "lengthM": 5.41,
      "refugeExpected": false,
      "why": "Scenario 1. Far from both doors, and the obvious route is also the correct one."
    },
    "bedroom-southeast": {
      "exitId": "exit-south",
      "lengthM": 10.48,
      "refugeExpected": false,
      "why": "Nothing is cut. The back door is the nearer of the two from this corner."
    }
  },
